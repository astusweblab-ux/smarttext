{
  "manifest_version": 3,
  "name": "SmartText",
  "version": "2.2.0",
  "description": "Локальный AI-ассистент для работы с текстом. Исправляет, сокращает, переводит — прямо в браузере. Created by ASTUS LAB.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SmartText",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "scripting",
    "activeTab",
    "notifications"
  ]
}
